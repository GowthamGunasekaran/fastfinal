# Application
APP_ENV=development
APP_TITLE=National One-Pager API
APP_VERSION=1.0.0

# SQLite (development default)
DATABASE_URL=sqlite:///./national_one_pager.db

# Future: GCP PostgreSQL / SQL Server
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
# DATABASE_URL=mssql+pyodbc://user:password@host:1433/dbname?driver=ODBC+Driver+17+for+SQL+Server

# Google Cloud Project & Cloud Storage (GCS) Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_SIGNED_URL_EXPIRATION_MINUTES=60
GCS_TIMEOUT_SECONDS=30
# Optional: Set to false if facing corporate SSL inspection or SSLCertVerificationError on local Windows
GCS_VERIFY_SSL=true
# Optional: Path to custom CA bundle (e.g. corporate proxy certificate)
# GCS_CA_BUNDLE=path/to/cacert.pem
# REQUESTS_CA_BUNDLE=path/to/cacert.pem
# Optional: Service Account Email for signing URLs when using ADC / impersonation
# GCS_SERVICE_ACCOUNT_EMAIL=your-sa@your-gcp-project-id.iam.gserviceaccount.com
# Optional: Path to Service Account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# GCP_SERVICE_ACCOUNT_PATH=path/to/service-account.json
# Optional: Service Account JSON string content
# GCP_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}



# GCP Cloud SQL (future reference — fill in when ready)
# GCP_REGION=asia-south1
# GCP_SQL_INSTANCE=my-instance
# GCP_DB_NAME=national_one_pager
# GCP_DB_USER=postgres
# GCP_DB_PASSWORD=changeme

