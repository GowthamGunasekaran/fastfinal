# ---------------------------------------------------------------------------
# Application Configuration
# ---------------------------------------------------------------------------
APP_ENV=development
APP_TITLE=National One-Pager API
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Database Configuration Options
# ---------------------------------------------------------------------------
# Option 1: Local SQLite (development default)
DB_TYPE=sqlite
DATABASE_URL=sqlite:///./national_one_pager.db

# Option 2: GCP Hosted PostgreSQL / Cloud SQL
# Set DB_TYPE=postgresql and configure credentials below:
# DB_TYPE=postgresql
# DB_HOST=10.0.0.3
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_db_password
# DB_NAME=national_one_pager
# DB_SCHEMA=public
# INSTANCE_CONNECTION_NAME=your-gcp-project:asia-south1:your-postgres-instance
# Or specify full connection URI directly:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Google Cloud Project & Cloud Storage (GCS) Configuration
# Cloud Run automatically authenticates via Application Default Credentials (ADC).
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_TIMEOUT_SECONDS=30
