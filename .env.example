# ---------------------------------------------------------------------------
# Application Configuration
# ---------------------------------------------------------------------------
APP_ENV=development
APP_TITLE=National One-Pager API
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Database Configuration (PostgreSQL Only)
# Automatic Detection:
# 1. GCP Cloud SQL: Triggered automatically when `K_SERVICE` is set in GCP Cloud Run
# 2. Local PostgreSQL: Used for local development when `K_SERVICE` is absent
# ---------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=national_one_pager
DB_SCHEMA=public

# Local PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432

# GCP Cloud SQL Configuration (used when deployed on Cloud Run)
INSTANCE_CONNECTION_NAME=your-gcp-project:region:your-postgres-instance

# ---------------------------------------------------------------------------
# Google Cloud Project & Cloud Storage (GCS) Configuration
# Cloud Run automatically authenticates via Application Default Credentials (ADC).
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_TIMEOUT_SECONDS=30
